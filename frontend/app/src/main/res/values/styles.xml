<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Base Unifyx Style                                   -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx">
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Toolbar                                             -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorSurface</item>
        <item name="titleTextColor">@color/textPrimary</item>
        <item name="subtitleTextColor">@color/textSecondary</item>
        <item name="navigationIconTint">@color/textPrimary</item>
        <item name="android:elevation">@dimen/elevation_sm</item>
    </style>

    <style name="Unifyx.Toolbar.Primary" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
        <item name="android:elevation">@dimen/elevation_md</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Button Styles                                       -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="elevation">@dimen/elevation_sm</item>
    </style>

    <style name="Unifyx.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Unifyx.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/colorSecondary</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Unifyx.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/error</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Unifyx.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Unifyx.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="backgroundTint">@color/colorPrimaryContainer</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:minHeight">@dimen/button_height_sm</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Unifyx.Button.Small" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:minHeight">@dimen/button_height_sm</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Unifyx.Button.SmallOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_full</item>
        <item name="android:minHeight">@dimen/button_height_sm</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Card Styles                                         -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Unifyx.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeColor">@color/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Unifyx.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">@dimen/elevation_md</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Input Styles                                        -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/colorOutline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/colorPrimary</item>
    </style>

    <style name="Unifyx.TextInputLayout.Filled" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxBackgroundColor">@color/inputBackgroundFilled</item>
        <item name="hintTextColor">@color/colorPrimary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Tab Styles                                          -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/colorPrimary</item>
        <item name="tabSelectedTextColor">@color/colorPrimary</item>
        <item name="tabTextColor">@color/textSecondary</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabRippleColor">@color/ripple</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Bottom Navigation                                   -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/colorBottomNav</item>
        <item name="itemIconTint">@color/colorBottomNavInactive</item>
        <item name="itemTextColor">@color/colorBottomNavInactive</item>
        <item name="itemActiveIndicatorStyle">@style/Unifyx.BottomNav.ActiveIndicator</item>
        <item name="android:elevation">@dimen/elevation_lg</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Unifyx.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/colorPrimaryContainer</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Chip Styles                                         -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/colorSurfaceVariant</item>
        <item name="chipStrokeColor">@color/colorOutlineVariant</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="checkedIconEnabled">true</item>
    </style>

    <style name="Unifyx.Chip.Choice" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/colorPrimaryContainer</item>
        <item name="chipCornerRadius">@dimen/radius_full</item>
        <item name="android:textColor">@color/colorOnPrimaryContainer</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Text Styles                                         -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.Text">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Unifyx.Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
    </style>

    <style name="Unifyx.Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/open_sans_bold</item>
    </style>

    <style name="Unifyx.Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Unifyx.Text.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="Unifyx.Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="Unifyx.Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="Unifyx.Text.Overline">
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:textColor">@color/textHint</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Badge Styles                                        -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.Badge">
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
        <item name="android:paddingTop">@dimen/spacing_xxs</item>
        <item name="android:paddingBottom">@dimen/spacing_xxs</item>
    </style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Empty State                                         -->
    <!-- ═══════════════════════════════════════════════════ -->

    <style name="Unifyx.EmptyState">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/textHint</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Unifyx.EmptyState.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
