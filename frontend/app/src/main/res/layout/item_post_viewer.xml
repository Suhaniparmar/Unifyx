<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_sm"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elevation_sm"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Post Image -->
        <ImageView
            android:id="@+id/postImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_image_height_sm"
            android:scaleType="centerCrop"
            android:background="@color/colorSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Title -->
            <TextView
                android:id="@+id/postTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Post Title"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <!-- Description -->
            <TextView
                android:id="@+id/postDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Post Description"
                android:textSize="@dimen/text_body"
                android:textColor="@color/textSecondary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/spacing_xs" />

            <!-- Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:background="@color/colorSurfaceVariant"
                android:padding="@dimen/spacing_sm">

                <TextView
                    android:id="@+id/postLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📍 Location"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:id="@+id/postDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ Duration"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/textPrimary" />
            </LinearLayout>

            <!-- Send Quote Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBidNow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_sm"
                android:text="Send Quote"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="@dimen/radius_full"
                android:layout_marginTop="@dimen/spacing_md" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
