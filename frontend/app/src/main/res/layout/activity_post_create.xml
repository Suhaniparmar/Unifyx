<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/background"
    tools:context="com.example.unifyx.MainActivity">

    <!-- Outer CardView for better UI -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical">

            <!-- Image Picker -->
            <Button
                android:id="@+id/btn_select_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Images"
                android:drawableLeft="@drawable/ic_camera"
                android:backgroundTint="@color/gray"
                android:textColor="@color/white"/>

            <!-- Selected Image Preview (Horizontal Scroll) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:id="@+id/image_preview_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

            </HorizontalScrollView>

            <!-- Description -->
            <EditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Description"
                android:minHeight="100dp"
                android:gravity="top"
                android:background="@drawable/edittext_border"
                android:padding="10dp"
                android:textColorHint="@color/gray"/>

            <!-- Worker/Contractor Selection Dropdown -->
            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_border"
                android:padding="10dp"/>

            <!-- Subcategory Dropdown (Initially Hidden) -->
            <Spinner
                android:id="@+id/spinner_sub_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edittext_border"
                android:padding="10dp"
                android:visibility="gone"/>


            <!-- Site Address -->
            <EditText
                android:id="@+id/et_site_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Site Address"
                android:background="@drawable/edittext_border"
                android:padding="10dp"
                android:textColorHint="@color/gray"/>

            <!-- Site Location (City) -->
            <EditText
                android:id="@+id/et_site_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter City"
                android:background="@drawable/edittext_border"
                android:padding="10dp"
                android:textColorHint="@color/gray"/>

            <!-- Duration (Months) -->
            <EditText
                android:id="@+id/et_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Duration (Months)"
                android:inputType="number"
                android:background="@drawable/edittext_border"
                android:padding="10dp"
                android:textColorHint="@color/gray"/>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:backgroundTint="@color/orange"
                android:textColor="@color/white"
                android:layout_marginTop="10dp"/>

            <!-- Progress Indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminate="true"
                android:layout_marginTop="10dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
