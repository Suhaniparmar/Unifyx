<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context="com.example.unifyx.MainActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Choose Your Role"
        android:textSize="@dimen/text_headline"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:fontFamily="@font/open_sans_bold"
        android:gravity="center"
        android:layout_marginTop="@dimen/spacing_xxl"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select how you'd like to use Unifyx"
        android:textSize="@dimen/text_body"
        android:textColor="@color/textSecondary"
        android:gravity="center"
        android:layout_marginTop="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@id/title_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Owner Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/owner_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/elevation_md"
        app:strokeWidth="0dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/subtitle_text"
        app:layout_constraintBottom_toTopOf="@id/worker_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/owner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_role_card_owner"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_lg">

            <ImageView
                android:layout_width="@dimen/role_icon_size"
                android:layout_height="@dimen/role_icon_size"
                android:contentDescription="Owner"
                android:src="@drawable/owner_icon"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Owner"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post jobs and find skilled workers"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="@dimen/spacing_xxs" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Worker Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/worker_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/elevation_md"
        app:strokeWidth="0dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/owner_card"
        app:layout_constraintBottom_toTopOf="@id/contractor_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/worker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_role_card_worker"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_lg">

            <ImageView
                android:layout_width="@dimen/role_icon_size"
                android:layout_height="@dimen/role_icon_size"
                android:contentDescription="Worker"
                android:src="@drawable/worker_icon"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Worker"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find work and send quotes"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="@dimen/spacing_xxs" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contractor Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contractor_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/elevation_md"
        app:strokeWidth="0dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/worker_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/contractor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_role_card_contractor"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_lg">

            <ImageView
                android:layout_width="@dimen/role_icon_size"
                android:layout_height="@dimen/role_icon_size"
                android:contentDescription="Contractor"
                android:src="@drawable/contractor_icon"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contractor"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage projects and bid on contracts"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="@dimen/spacing_xxs" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
