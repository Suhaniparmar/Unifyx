<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_sm"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elevation_sm"
    app:strokeWidth="0dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md"
        android:gravity="center_vertical">

        <!-- Amount Icon -->
        <ImageView
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:src="@drawable/ic_profile_placeholder"
            android:background="@drawable/bg_avatar_circle"
            android:scaleType="centerCrop"
            android:contentDescription="Worker" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_md">

            <TextView
                android:id="@+id/amountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹5,000"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <TextView
                android:id="@+id/durationTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duration: 7 days"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="@dimen/spacing_xxs" />

            <TextView
                android:id="@+id/workerEmailTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="example@worker.com"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="@dimen/spacing_xxs" />

            <TextView
                android:id="@+id/workerPhoneTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91 9876543210"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="@dimen/spacing_xxs" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
