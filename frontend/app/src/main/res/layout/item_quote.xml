<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_sm"
    android:layout_marginVertical="@dimen/spacing_xs"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="@dimen/elevation_sm"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Worker Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/workerAvatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:src="@drawable/ic_profile_placeholder"
                android:contentDescription="@string/worker_avatar"
                android:background="@drawable/bg_avatar_circle"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/spacing_md">

                <TextView
                    android:id="@+id/workerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jane Smith"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:id="@+id/submitTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Submitted 2 hours ago"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/textHint" />
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="@dimen/text_overline"
                android:textStyle="bold"
                android:background="@drawable/badge_pending"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="@dimen/spacing_xxs"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Quote Details Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@color/colorSurfaceVariant"
            android:padding="@dimen/spacing_sm">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Price:"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:textColor="@color/textSecondary" />

            <TextView
                android:id="@+id/quotePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹3,200"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="@dimen/spacing_md" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time:"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:textColor="@color/textSecondary" />

            <TextView
                android:id="@+id/estimatedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 days"
                android:textSize="@dimen/text_caption"
                android:layout_marginStart="@dimen/spacing_xs"
                android:textColor="@color/colorPrimary" />
        </LinearLayout>

        <!-- Quote Message -->
        <TextView
            android:id="@+id/quoteMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I can complete this project quickly with high quality."
            android:textSize="@dimen/text_body"
            android:textColor="@color/textPrimary"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="@dimen/spacing_sm" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginVertical="@dimen/spacing_sm" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rejectBtn"
                style="@style/Unifyx.Button.SmallOutline"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_sm"
                android:layout_weight="1"
                android:text="Reject"
                android:textColor="@color/textSecondary"
                app:strokeColor="@color/colorOutline"
                app:cornerRadius="@dimen/radius_full"
                android:layout_marginEnd="@dimen/spacing_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/acceptBtn"
                style="@style/Unifyx.Button.Small"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_sm"
                android:layout_weight="1"
                android:text="Accept &amp; Hire"
                android:textColor="@color/white"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="@dimen/radius_full"
                android:layout_marginStart="@dimen/spacing_xs" />
        </LinearLayout>

        <!-- Hire Lifecycle Section (shown only once a Hire exists for this quote) -->
        <LinearLayout
            android:id="@+id/hireSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_sm">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <TextView
                android:id="@+id/hireStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hire: ACTIVE"
                android:textStyle="bold"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/textSecondary"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/markCompleteBtn"
                style="@style/Unifyx.Button.Small"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_sm"
                android:text="Mark Complete"
                android:textColor="@color/white"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="@dimen/radius_full"
                android:visibility="gone" />

            <!-- Rating & Review (shown once the Hire is COMPLETED and not yet rated) -->
            <LinearLayout
                android:id="@+id/ratingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <RatingBar
                    android:id="@+id/ratingInput"
                    style="?android:attr/ratingBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1"
                    android:rating="0"
                    android:progressTint="@color/colorPrimary"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/reviewInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Add a review (optional)"
                    android:textSize="@dimen/text_body"
                    android:background="@drawable/bg_input_modern"
                    android:padding="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitRatingBtn"
                    style="@style/Unifyx.Button.Small"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height_sm"
                    android:text="Submit Rating"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="@dimen/radius_full" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
